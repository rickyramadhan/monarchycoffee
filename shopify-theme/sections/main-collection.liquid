<section class="page-head container"><div class="breadcrumb"><a href="{{ routes.root_url }}">{{ section.settings.home_label | escape }}</a> / {{ collection.title | escape }}</div><h1>{{ collection.title | escape }}</h1>{% if collection.description != blank %}<div class="rte">{{ collection.description }}</div>{% endif %}</section><section class="container shop-bottom"><form class="shop-tools" method="get"><div class="tabs"><a class="tab{% unless current_tags %} active{% endunless %}" href="{{ collection.url }}">{{ section.settings.all_label | escape }}</a>{% for tag in collection.all_tags %}{{ tag | link_to_tag: tag | replace: '<a', '<a class="tab"' }}{% endfor %}</div><label class="sort">{{ section.settings.sort_label | escape }} <select name="sort_by" onchange="this.form.submit()">{% assign sort_by = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}</select></label></form>{% paginate collection.products by section.settings.products_per_page %}<div class="products-grid">{% for product in collection.products %}{% render 'product-card', card_product: product %}{% else %}<p>{{ section.settings.empty_label | escape }}</p>{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="pagination" aria-label="{{ section.settings.pagination_label | escape }}">{% if paginate.previous %}<a href="{{ paginate.previous.url }}">{{ section.settings.previous_label | escape }}</a>{% endif %}<span>{{ paginate.current_page }} / {{ paginate.pages }}</span>{% if paginate.next %}<a href="{{ paginate.next.url }}">{{ section.settings.next_label | escape }}</a>{% endif %}</nav>{% endif %}{% endpaginate %}</section>
{% schema %}{"name":"Main collection","settings":[{"type":"text","id":"home_label","label":"Breadcrumb home label","default":"Beranda"},{"type":"text","id":"all_label","label":"All products filter label","default":"Semua produk"},{"type":"text","id":"sort_label","label":"Sort label","default":"Urutkan"},{"type":"range","id":"products_per_page","label":"Products per page","min":4,"max":48,"step":4,"default":12},{"type":"text","id":"empty_label","label":"Empty collection message","default":"Koleksi ini belum memiliki produk."},{"type":"text","id":"pagination_label","label":"Pagination accessibility label","default":"Navigasi halaman"},{"type":"text","id":"previous_label","label":"Previous page label","default":"Sebelumnya"},{"type":"text","id":"next_label","label":"Next page label","default":"Berikutnya"}]}{% endschema %}
