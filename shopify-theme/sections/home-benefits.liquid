<section class="benefits container" aria-label="{{ section.settings.accessibility_label | escape }}">{% for block in section.blocks %}<div {{ block.shopify_attributes }}><span class="benefit-icon" aria-hidden="true">{% case block.settings.icon %}{% when 'bean' %}♨{% when 'cup' %}◒{% when 'box' %}▣{% else %}♡{% endcase %}</span><span><b>{{ block.settings.heading | escape }}</b><small>{{ block.settings.copy | escape }}</small></span></div>{% endfor %}</section>
{% schema %}{"name":"Home benefits","settings":[{"type":"text","id":"accessibility_label","label":"Accessibility label","default":"Keunggulan Monarchy Coffee"}],"blocks":[{"type":"benefit","name":"Benefit","settings":[{"type":"select","id":"icon","label":"Icon","options":[{"value":"bean","label":"Roastery"},{"value":"cup","label":"Coffee"},{"value":"box","label":"Range"},{"value":"hand","label":"Partnership"}],"default":"bean"},{"type":"text","id":"heading","label":"Heading","default":"Diracik di roastery kami"},{"type":"text","id":"copy","label":"Description","default":"Karakter kopi yang dipilih dengan teliti"}]}],"max_blocks":4,"presets":[{"name":"Home benefits","blocks":[{"type":"benefit","settings":{"icon":"bean","heading":"Diracik di roastery kami","copy":"Karakter kopi yang dipilih dengan teliti"}},{"type":"benefit","settings":{"icon":"cup","heading":"Ada rasa untuk setiap hari","copy":"Signature blends & coffee capsules"}},{"type":"benefit","settings":{"icon":"box","heading":"Dari rumah hingga bisnis","copy":"Pilihan kopi untuk beragam kebutuhan"}},{"type":"benefit","settings":{"icon":"hand","heading":"Partner kopi sejak 2012","copy":"Bertumbuh bersama dunia hospitality"}}]}]}{% endschema %}
