<section class="page-head container"><span class="eyebrow">{{ section.settings.eyebrow | escape }}</span><h1>{{ section.settings.heading | escape | newline_to_br }}</h1><p>{{ section.settings.intro | escape }}</p></section><section class="container section guide-page-cards" style="padding-top:10px"><div class="guide-grid">{% for block in section.blocks %}<article class="guide-card" {{ block.shopify_attributes }}><span class="guide-no">0{{ forloop.index }}</span><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.copy | escape }}</p>{% if block.settings.link != blank %}<a class="text-link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>{% endif %}</article>{% endfor %}</div></section><section class="split-feature guide-feature"><div class="feature-img">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: section.settings.image_alt }}{% else %}<img src="{{ 'capsule-hero.webp' | asset_url }}" alt="{{ section.settings.image_alt | escape }}" loading="lazy" width="1600" height="1068">{% endif %}</div><div class="feature-copy"><span class="eyebrow">{{ section.settings.feature_eyebrow | escape }}</span><h2>{{ section.settings.feature_heading | escape | newline_to_br }}</h2><p>{{ section.settings.feature_copy | escape }}</p><a class="btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a></div></section>
{% schema %}{"name":"Coffee Guide page","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"COFFEE GUIDE"},{"type":"textarea","id":"heading","label":"Heading","default":"Kenali kopi.\nNikmati dengan cara Anda."},{"type":"textarea","id":"intro","label":"Introduction","default":"Panduan singkat untuk memilih rasa, gilingan, dan format kopi yang cocok."},{"type":"image_picker","id":"image","label":"Feature image"},{"type":"text","id":"image_alt","label":"Image description","default":"Kapsul Americano Monarchy"},{"type":"text","id":"feature_eyebrow","label":"Feature eyebrow","default":"START SIMPLE"},{"type":"textarea","id":"feature_heading","label":"Feature heading","default":"Tidak ada satu cara\nuntuk menikmati kopi."},{"type":"textarea","id":"feature_copy","label":"Feature description","default":"Anda suka kopi susu yang pekat atau Americano yang ringan? Mulai dari selera Anda sendiri, lalu temukan kopi yang paling pas."},{"type":"text","id":"button_label","label":"Button label","default":"Jelajahi Koleksi"},{"type":"url","id":"button_link","label":"Button link"}],"blocks":[{"type":"guide","name":"Guide card","settings":[{"type":"text","id":"title","label":"Title","default":"Kopi seperti apa yang Anda suka?"},{"type":"textarea","id":"copy","label":"Description","default":"Mulai dari rasa. Temukan blend untuk kopi susu, kopi hitam, atau espresso favorit Anda."},{"type":"text","id":"link_label","label":"Link label","default":"Temukan blend Anda"},{"type":"url","id":"link","label":"Link"}]}],"max_blocks":3,"presets":[{"name":"Coffee Guide page","blocks":[{"type":"guide","settings":{"title":"Kopi seperti apa yang Anda suka?","copy":"Mulai dari rasa. Temukan blend untuk kopi susu, kopi hitam, atau espresso favorit Anda.","link_label":"Temukan blend Anda","link":"/pages/coffee-guide#guide-find"}},{"type":"guide","settings":{"title":"Biji utuh atau kopi giling?","copy":"Kenali pilihan yang cocok dengan alat seduh di rumah, supaya tidak salah pilih.","link_label":"Kenali gilingan kopi","link":"/pages/coffee-guide#guide-grind"}},{"type":"guide","settings":{"title":"Sudut kopi, tanpa ribet.","copy":"Hal yang perlu diperhatikan sebelum memilih kapsul dan mesin kopi pertama.","link_label":"Baca panduan kapsul","link":"/pages/coffee-guide#guide-capsule"}}]}]}{% endschema %}