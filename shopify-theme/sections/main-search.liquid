<section class="container section"><div class="page-head"><span class="eyebrow">{{ section.settings.eyebrow | escape }}</span><h1>{{ section.settings.heading | escape }}</h1></div><form action="{{ routes.search_url }}" method="get" class="search-box"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ section.settings.placeholder | escape }}" aria-label="{{ section.settings.input_label | escape }}"><input type="hidden" name="type" value="product"><button class="btn" type="submit">{{ section.settings.submit_label | escape }}</button></form>{% if search.performed %}<p>{{ search.results_count }} {{ section.settings.results_for | escape }} “{{ search.terms | escape }}”</p>{% paginate search.results by section.settings.products_per_page %}<div class="products-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', card_product: item %}{% endif %}{% else %}<p>{{ section.settings.no_results | escape }}</p>{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="pagination" aria-label="{{ section.settings.pagination_label | escape }}">{% if paginate.previous %}<a href="{{ paginate.previous.url }}">{{ section.settings.previous_label | escape }}</a>{% endif %}<span>{{ paginate.current_page }} / {{ paginate.pages }}</span>{% if paginate.next %}<a href="{{ paginate.next.url }}">{{ section.settings.next_label | escape }}</a>{% endif %}</nav>{% endif %}{% endpaginate %}{% endif %}</section>
{% schema %}{"name":"Main search","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"MONARCHY COFFEE"},{"type":"text","id":"heading","label":"Heading","default":"Hasil pencarian"},{"type":"text","id":"placeholder","label":"Search placeholder","default":"Cari kopi, karakter rasa, atau mesin…"},{"type":"text","id":"input_label","label":"Search field accessibility label","default":"Cari produk"},{"type":"text","id":"submit_label","label":"Search button","default":"Cari"},{"type":"text","id":"results_for","label":"Results context","default":"hasil untuk"},{"type":"range","id":"products_per_page","label":"Results per page","min":4,"max":48,"step":4,"default":12},{"type":"text","id":"no_results","label":"No results message","default":"Tidak ada produk ditemukan."},{"type":"text","id":"pagination_label","label":"Pagination accessibility label","default":"Navigasi halaman"},{"type":"text","id":"previous_label","label":"Previous page label","default":"Sebelumnya"},{"type":"text","id":"next_label","label":"Next page label","default":"Berikutnya"}]}{% endschema %}
