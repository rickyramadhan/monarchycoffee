<header class="header"><a href="{{ routes.root_url }}" class="brand" aria-label="{{ shop.name | escape }}"><img src="{% if settings.logo != blank %}{{ settings.logo | image_url: width: 400 }}{% else %}{{ 'logo.png' | asset_url }}{% endif %}" alt="{{ shop.name | escape }}" width="201" height="120"></a><nav id="SiteNavigation" aria-label="{{ section.settings.navigation_label | escape }}">{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}{% if link.url contains '/pages/untuk-bisnis' %} <span class="tiny-badge">B2B</span>{% endif %}</a>{% endfor %}</nav><div class="nav-actions"><button class="icon-btn" type="button" data-search-open aria-label="{{ section.settings.search_label | escape }}" aria-haspopup="dialog">{{ section.settings.search_icon | escape }}</button><button class="cart-trigger" type="button" data-cart-open aria-label="{{ section.settings.cart_label | escape }}">{{ section.settings.cart_label | escape }} <span data-cart-count>{{ cart.item_count }}</span></button><button class="icon-btn menu-toggle" type="button" data-mobile-menu-toggle aria-controls="SiteNavigation" aria-label="{{ section.settings.menu_button_label | escape }}" aria-expanded="false">{{ section.settings.menu_icon | escape }}</button></div></header>
<dialog class="search-dialog" id="SearchDialog" aria-labelledby="SearchDialogTitle"><form action="{{ routes.search_url }}" method="get" role="search" class="search-dialog__form"><div class="search-dialog__heading"><div><span class="eyebrow">MONARCHY COFFEE</span><h2 id="SearchDialogTitle">Temukan kopi favoritmu</h2></div><button type="button" class="search-dialog__close" data-search-close aria-label="Tutup pencarian">×</button></div><label class="visually-hidden" for="HeaderSearchInput">Cari kopi atau perlengkapan</label><div class="search-dialog__field"><input id="HeaderSearchInput" type="search" name="q" placeholder="Coba “espresso”, “kapsul”, atau “cokelat”…" autocomplete="off" enterkeyhint="search"><input type="hidden" name="type" value="product"><button class="btn" type="submit">Cari</button></div><p class="search-dialog__hint">Cari berdasarkan nama kopi, rasa, atau perlengkapan.</p></form></dialog>
{% schema %}{"name":"Site header","settings":[{"type":"link_list","id":"menu","label":"Menu","default":"main-menu"},{"type":"text","id":"navigation_label","label":"Navigation accessibility label","default":"Navigasi utama"},{"type":"text","id":"search_label","label":"Search accessibility label","default":"Cari produk"},{"type":"text","id":"search_icon","label":"Search icon character","default":"⌕"},{"type":"text","id":"cart_label","label":"Cart label","default":"Keranjang"},{"type":"text","id":"menu_button_label","label":"Mobile menu button label","default":"Buka menu"},{"type":"text","id":"menu_icon","label":"Mobile menu icon character","default":"☰"}],"presets":[{"name":"Site header"}]}{% endschema %}
