<section class="container section story-hero reveal"><div><span class="eyebrow">{{ section.settings.eyebrow | escape }}</span><h1>{{ section.settings.heading | escape | newline_to_br }}</h1><p>{{ section.settings.intro | escape }}</p><p>{{ section.settings.body | escape }}</p><div class="button-row"><a class="btn" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label | escape }}</a><a class="text-link" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label | escape }}</a></div></div><div class="story-image">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: section.settings.image_alt }}{% else %}<img src="{{ 'brand-story.webp' | asset_url }}" alt="{{ section.settings.image_alt | escape }}" loading="lazy" width="1024" height="1536">{% endif %}</div></section><section class="section container story-timeline"><span class="eyebrow">{{ section.settings.timeline_eyebrow | escape }}</span><h2>{{ section.settings.timeline_heading | escape }}</h2><div class="timeline">{% for block in section.blocks %}<article {{ block.shopify_attributes }}><strong>{{ block.settings.year | escape }}</strong><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.copy | escape }}</p></article>{% endfor %}</div></section><section class="trust container"><span class="eyebrow">{{ section.settings.trust_heading | escape }}</span><div class="client-names"><span>{{ section.settings.client_one | escape }}<small>{{ section.settings.client_one_subtitle | escape }}</small></span><span>{{ section.settings.client_two | escape }}<small>{{ section.settings.client_two_subtitle | escape }}</small></span><span>{{ section.settings.client_three | escape }}<small>{{ section.settings.client_three_subtitle | escape }}</small></span><span>{{ section.settings.client_four | escape }}<small>{{ section.settings.client_four_subtitle | escape }}</small></span></div><p class="section-note">{{ section.settings.trust_note | escape }}</p></section><section class="cta-band story-cta"><div><h2>{{ section.settings.cta_heading | escape }}</h2><p>{{ section.settings.cta_copy | escape }}</p></div><a class="btn" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label | escape }}</a></section>
{% schema %}{"name":"Story page","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"OUR STORY · SINCE 2012"},{"type":"textarea","id":"heading","label":"Heading","default":"Berawal dari kopi.\nBertumbuh bersama\norang-orangnya."},{"type":"textarea","id":"intro","label":"Introduction","default":"Pada 2012, perjalanan kami dimulai dari sebuah micro roastery. Fokusnya sederhana: menyediakan kopi untuk hotel, restoran, dan kafe."},{"type":"textarea","id":"body","label":"Body","default":"Di bawah PT Gemilang Artha Makmur Abadi, Monarchy berkembang dengan pilihan roasted coffee, kapsul, serta mesin kopi. Karena kopi yang baik bukan hanya soal rasa, tetapi juga bagaimana kopi menjadi bagian dari hari dan usaha seseorang."},{"type":"image_picker","id":"image","label":"Story image"},{"type":"text","id":"image_alt","label":"Image description","default":"Kemasan asli Monarchy Coffee dan kopi yang sedang diseduh"},{"type":"text","id":"primary_label","label":"Primary button","default":"Kenali Kopi Kami"},{"type":"url","id":"primary_link","label":"Primary link"},{"type":"text","id":"secondary_label","label":"Secondary link label","default":"Tumbuh bersama Monarchy"},{"type":"url","id":"secondary_link","label":"Secondary link"},{"type":"text","id":"timeline_eyebrow","label":"Timeline eyebrow","default":"ONE CUP, ONE CHAPTER AT A TIME"},{"type":"text","id":"timeline_heading","label":"Timeline heading","default":"Perjalanan yang terus diseduh."},{"type":"text","id":"trust_heading","label":"Trust heading","default":"Corporate account Monarchy"},{"type":"text","id":"client_one","label":"Client 1","default":"Santika Hospitality"},{"type":"text","id":"client_one_subtitle","label":"Client 1 subtitle","default":"Corporate account"},{"type":"text","id":"client_two","label":"Client 2","default":"Ascott Hospitality"},{"type":"text","id":"client_two_subtitle","label":"Client 2 subtitle","default":"Corporate account"},{"type":"text","id":"client_three","label":"Client 3","default":"Injourney Hospitality"},{"type":"text","id":"client_three_subtitle","label":"Client 3 subtitle","default":"Corporate account"},{"type":"text","id":"client_four","label":"Client 4","default":"Accor properties"},{"type":"text","id":"client_four_subtitle","label":"Client 4 subtitle","default":"Served; not corporate vendor"},{"type":"text","id":"trust_note","label":"Trust note","default":"Properti Accor yang dilayani termasuk ibis, ibis Styles, Mercure, Novotel, dan Swissôtel; bukan corporate vendor."},{"type":"text","id":"cta_heading","label":"CTA heading","default":"Bab berikutnya, mungkin bersama Anda."},{"type":"text","id":"cta_copy","label":"CTA description","default":"Mari bicarakan kopi untuk keseharian atau usaha Anda."},{"type":"text","id":"cta_label","label":"CTA button","default":"Mulai Percakapan"},{"type":"url","id":"cta_link","label":"CTA link"}],"blocks":[{"type":"milestone","name":"Milestone","settings":[{"type":"text","id":"year","label":"Year","default":"2012"},{"type":"text","id":"title","label":"Title","default":"Awal perjalanan"},{"type":"textarea","id":"copy","label":"Description","default":"Memulai micro roastery untuk segmen hotel, kafe, dan restoran."}]}],"max_blocks":8,"presets":[{"name":"Story page","blocks":[{"type":"milestone","settings":{"year":"2012","title":"Awal perjalanan","copy":"Memulai micro roastery untuk segmen hotel, kafe, dan restoran."}},{"type":"milestone","settings":{"year":"2014","title":"Kapasitas baru","copy":"Investasi mesin roasting berkapasitas 15 kg per batch."}},{"type":"milestone","settings":{"year":"2019","title":"Wajah Monarchy","copy":"Pembaruan brand, identitas visual, dan kemasan produk."}},{"type":"milestone","settings":{"year":"2021","title":"Bersama hospitality","copy":"Mengembangkan kerja sama pengadaan kopi dengan jaringan hotel."}},{"type":"milestone","settings":{"year":"2023","title":"Terus berkembang","copy":"Memperluas portofolio melalui pengembangan produk."}}]}]}{% endschema %}