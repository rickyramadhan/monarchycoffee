<section class="section dark"><div class="container business-preview"><div><span class="eyebrow">{{ section.settings.eyebrow | escape }}</span><h2>{{ section.settings.heading | escape | newline_to_br }}</h2><p>{{ section.settings.copy | escape }}</p><a href="{{ section.settings.button_link | default: '/pages/untuk-bisnis' }}" class="btn yellow">{{ section.settings.button_label | escape }}</a></div><div class="solution-list">{% for block in section.blocks %}<a href="{{ block.settings.link }}" {{ block.shopify_attributes }}><span class="num">0{{ forloop.index }}</span><div><h3>{{ block.settings.heading | escape }}</h3><p>{{ block.settings.copy | escape }}</p></div></a>{% endfor %}</div></div></section>
{% schema %}{"name":"Home business solutions","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"MONARCHY FOR BUSINESS"},{"type":"textarea","id":"heading","label":"Heading","default":"Anda punya rencana.\nKami punya kopinya."},{"type":"textarea","id":"copy","label":"Description","default":"Buka kafe, lengkapi pengalaman tamu hotel, atau hadirkan coffee corner di tempat olahraga. Mari susun kebutuhan kopi yang sesuai dengan usaha Anda."},{"type":"text","id":"button_label","label":"Button label","default":"Kenali Solusi Bisnis"},{"type":"url","id":"button_link","label":"Button link"}],"blocks":[{"type":"solution","name":"Solution","settings":[{"type":"text","id":"heading","label":"Heading","default":"Kopi & pasokan rutin"},{"type":"text","id":"copy","label":"Description","default":"Blend yang tepat untuk menu dan pelanggan Anda."},{"type":"url","id":"link","label":"Link"}]}],"max_blocks":3,"presets":[{"name":"Home business solutions","blocks":[{"type":"solution","settings":{"heading":"Kopi & pasokan rutin","copy":"Blend yang tepat untuk menu dan pelanggan Anda."}},{"type":"solution","settings":{"heading":"Mesin & persiapan coffee bar","copy":"Mulai dari kebutuhan alat, kapasitas, hingga alur kerja."}},{"type":"solution","settings":{"heading":"Kopi dengan nama Anda","copy":"Custom blend untuk membangun identitas brand sendiri."}}]}]}{% endschema %}