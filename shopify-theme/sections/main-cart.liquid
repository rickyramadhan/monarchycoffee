<section class="container section"><div class="page-head"><span class="eyebrow">{{ section.settings.eyebrow | escape }}</span><h1>{{ section.settings.heading | escape }}</h1></div>{% if cart.item_count == 0 %}<div class="empty"><h2>{{ section.settings.empty_heading | escape }}</h2><p>{{ section.settings.empty_copy | escape }}</p><a href="{{ routes.all_products_collection_url }}" class="btn">{{ section.settings.shop_label | escape }}</a></div>{% else %}<form action="{{ routes.cart_url }}" method="post" novalidate><div class="cart-page-items">{% for item in cart.items %}<article class="cart-item"><a href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 180 | image_tag: loading: 'lazy', alt: item.image.alt }}{% endif %}</a><div><h3><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h3><small>{{ item.variant.title | escape }}</small>{% for property in item.properties %}{% assign first_char = property.first | slice: 0 %}{% unless property.last == blank or first_char == '_' %}<small>{{ property.first | escape }}: {{ property.last | escape }}</small>{% endunless %}{% endfor %}<label for="CartQty-{{ item.key }}">{{ section.settings.quantity_label | escape }}</label><input id="CartQty-{{ item.key }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0"><a class="remove" href="{{ item.url_to_remove }}">{{ section.settings.remove_label | escape }}</a></div><strong>{{ item.final_line_price | money }}</strong></article>{% endfor %}</div><label for="CartNote">{{ section.settings.note_label | escape }}</label><textarea id="CartNote" name="note">{{ cart.note | escape }}</textarea><div class="total-line"><strong>{{ section.settings.subtotal_label | escape }}</strong><strong>{{ cart.total_price | money }}</strong></div><p class="small muted">{{ section.settings.shipping_note | escape }}</p><div class="button-row"><button class="btn outline" type="submit" name="update">{{ section.settings.update_label | escape }}</button><button class="btn" type="submit" name="checkout">{{ section.settings.checkout_label | escape }}</button></div></form>{% endif %}</section>
{% schema %}{"name":"Main cart","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"MONARCHY COFFEE"},{"type":"text","id":"heading","label":"Heading","default":"Keranjang Anda"},{"type":"text","id":"empty_heading","label":"Empty cart heading","default":"Keranjang Anda masih kosong."},{"type":"text","id":"empty_copy","label":"Empty cart description","default":"Pilih kopi favorit sebelum melanjutkan."},{"type":"text","id":"shop_label","label":"Continue shopping button","default":"Mulai Belanja"},{"type":"text","id":"quantity_label","label":"Quantity label","default":"Jumlah"},{"type":"text","id":"remove_label","label":"Remove item label","default":"Hapus"},{"type":"text","id":"note_label","label":"Order note label","default":"Catatan pesanan"},{"type":"text","id":"subtotal_label","label":"Subtotal label","default":"Subtotal"},{"type":"text","id":"shipping_note","label":"Shipping note","default":"Ongkir dan pajak dihitung di checkout sesuai konfigurasi toko."},{"type":"text","id":"update_label","label":"Update cart button","default":"Perbarui keranjang"},{"type":"text","id":"checkout_label","label":"Checkout button","default":"Lanjut ke checkout"}]}{% endschema %}
