<footer><div class="footer-top container"><div class="footer-brand"><img src="{% if section.settings.footer_logo != blank %}{{ section.settings.footer_logo | image_url: width: 340 }}{% elsif settings.logo_footer != blank %}{{ settings.logo_footer | image_url: width: 340 }}{% else %}{{ 'logo-white.png' | asset_url }}{% endif %}" alt="{{ shop.name | escape }}" width="170" height="60"><p>{{ section.settings.tagline | escape }}</p></div><div><h3>{{ section.settings.shop_heading | escape }}</h3>{% for link in section.settings.shop_menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}</div><div><h3>{{ section.settings.info_heading | escape }}</h3>{% for link in section.settings.info_menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}</div><div><h3>{{ section.settings.contact_heading | escape }}</h3>{% if section.settings.email != blank %}<a href="mailto:{{ section.settings.email | escape }}">{{ section.settings.email | escape }}</a>{% endif %}<p>{{ section.settings.address | escape | newline_to_br }}</p></div></div><div class="footer-bottom container"><span>{{ section.settings.copyright_prefix | escape }} {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</span><span>{{ section.settings.signature | escape }}</span></div></footer>
{% schema %}{"name":"Site footer","settings":[{"type":"image_picker","id":"footer_logo","label":"Footer logo override"},{"type":"text","id":"tagline","label":"Tagline","default":"Kopi yang baik. Untuk hari dan usaha yang baik."},{"type":"text","id":"shop_heading","label":"Shop links heading","default":"Belanja"},{"type":"link_list","id":"shop_menu","label":"Shop menu"},{"type":"text","id":"info_heading","label":"Information links heading","default":"Informasi"},{"type":"link_list","id":"info_menu","label":"Information menu"},{"type":"text","id":"contact_heading","label":"Contact heading","default":"Mari ngobrol."},{"type":"text","id":"email","label":"Contact email","default":"info@monarchycoffee.com"},{"type":"textarea","id":"address","label":"Address","default":"Swadaya City Square Blok II No. 20\nJakarta Barat"},{"type":"text","id":"copyright_prefix","label":"Copyright prefix","default":"©"},{"type":"text","id":"signature","label":"Footer signature","default":"GOOD COFFEE. GOOD COMPANY."}],"presets":[{"name":"Site footer"}]}{% endschema %}
