<section class="container section"><div class="page-head"><span class="eyebrow">{{ section.settings.eyebrow | escape }}</span><h1>{{ blog.title | escape }}</h1>{% if section.settings.intro != blank %}<p>{{ section.settings.intro | escape }}</p>{% endif %}</div>{% paginate blog.articles by section.settings.articles_per_page %}<div class="guide-grid">{% for article in blog.articles %}<article class="guide-card" {{ article.shopify_attributes }}><a href="{{ article.url }}">{% if article.image %}{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: article.image.alt }}{% endif %}<span class="eyebrow">{{ article.published_at | date: format: 'date' }}</span><h2>{{ article.title | escape }}</h2><p>{{ article.excerpt_or_content | strip_html | truncate: 180 | escape }}</p><span>{{ section.settings.read_more | escape }}</span></a></article>{% else %}<p>{{ section.settings.empty_message | escape }}</p>{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="pagination" aria-label="{{ section.settings.pagination_label | escape }}">{% if paginate.previous %}<a href="{{ paginate.previous.url }}">{{ section.settings.previous_label | escape }}</a>{% endif %}<span>{{ paginate.current_page }} / {{ paginate.pages }}</span>{% if paginate.next %}<a href="{{ paginate.next.url }}">{{ section.settings.next_label | escape }}</a>{% endif %}</nav>{% endif %}{% endpaginate %}</section>
{% schema %}{"name":"Main blog","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"JURNAL MONARCHY"},{"type":"textarea","id":"intro","label":"Introductory text"},{"type":"range","id":"articles_per_page","label":"Articles per page","min":3,"max":18,"step":3,"default":9},{"type":"text","id":"read_more","label":"Read more label","default":"Baca selengkapnya"},{"type":"text","id":"empty_message","label":"Empty blog message","default":"Belum ada artikel."},{"type":"text","id":"pagination_label","label":"Pagination accessibility label","default":"Navigasi artikel"},{"type":"text","id":"previous_label","label":"Previous page label","default":"Sebelumnya"},{"type":"text","id":"next_label","label":"Next page label","default":"Berikutnya"}]}{% endschema %}
