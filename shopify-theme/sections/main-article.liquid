<article class="container section"><header class="page-head"><a href="{{ blog.url }}">{{ section.settings.back_label | escape }} {{ blog.title | escape }}</a><span class="eyebrow">{{ article.published_at | date: format: 'date' }}</span><h1>{{ article.title | escape }}</h1>{% if section.settings.show_author and article.author != blank %}<p>{{ section.settings.author_prefix | escape }} {{ article.author | escape }}</p>{% endif %}</header>{% if article.image %}<div class="article-image">{{ article.image | image_url: width: 1600 | image_tag: loading: 'eager', alt: article.image.alt }}</div>{% endif %}<div class="rte">{{ article.content }}</div>{% if blog.comments_enabled? %}<div class="article-comments"><h2>{{ section.settings.comments_heading | escape }}</h2>{% paginate article.comments by 10 %}{% for comment in article.comments %}<div class="comment"><strong>{{ comment.author | escape }}</strong><p>{{ comment.content }}</p></div>{% endfor %}{% if paginate.pages > 1 %}<nav class="pagination">{{ paginate | default_pagination }}</nav>{% endif %}{% endpaginate %}{% form 'new_comment', article %}<div class="field"><label for="CommentAuthor">{{ section.settings.name_label | escape }}</label><input id="CommentAuthor" name="comment[author]" required></div><div class="field"><label for="CommentEmail">{{ section.settings.email_label | escape }}</label><input id="CommentEmail" type="email" name="comment[email]" required></div><div class="field"><label for="CommentBody">{{ section.settings.comment_label | escape }}</label><textarea id="CommentBody" name="comment[body]" required></textarea></div><button class="btn" type="submit">{{ section.settings.submit_label | escape }}</button>{% if form.errors %}<div role="alert">{{ form.errors | default_errors }}</div>{% endif %}{% if form.posted_successfully? %}<p role="status">{{ section.settings.success_message | escape }}</p>{% endif %}{% endform %}</div>{% endif %}</article>
{% schema %}{"name":"Main article","settings":[{"type":"text","id":"back_label","label":"Blog back link label","default":"← Jurnal:"},{"type":"checkbox","id":"show_author","label":"Show author","default":true},{"type":"text","id":"author_prefix","label":"Author prefix","default":"Oleh"},{"type":"text","id":"comments_heading","label":"Comments heading","default":"Komentar"},{"type":"text","id":"name_label","label":"Name field label","default":"Nama"},{"type":"text","id":"email_label","label":"Email field label","default":"Email"},{"type":"text","id":"comment_label","label":"Comment field label","default":"Komentar Anda"},{"type":"text","id":"submit_label","label":"Submit button","default":"Kirim komentar"},{"type":"text","id":"success_message","label":"Success message","default":"Komentar terkirim untuk ditinjau."}]}{% endschema %}
