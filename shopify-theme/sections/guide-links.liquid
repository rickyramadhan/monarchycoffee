<section class="section container"><div class="section-heading"><div><span class="eyebrow">COFFEE GUIDE</span><h2>{{ section.settings.heading | escape | newline_to_br }}</h2></div></div><div class="guide-grid">{% for block in section.blocks %}<article class="guide-card" {{ block.shopify_attributes }}><span class="guide-no">0{{ forloop.index }}</span><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.copy | escape }}</p>{% if block.settings.link != blank %}<a class="text-link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>{% endif %}</article>{% endfor %}</div></section>
{% schema %}{"name":"Guide links","settings":[{"type":"text","id":"heading","label":"Heading","default":"Kenali kopi. Nikmati dengan cara Anda."}],"blocks":[{"type":"guide","name":"Guide","settings":[{"type":"text","id":"title","label":"Title","default":"Pilih kopi sesuai selera"},{"type":"textarea","id":"copy","label":"Description","default":"Panduan singkat untuk menemukan kopi yang pas."},{"type":"text","id":"link_label","label":"Link label","default":"Baca panduan"},{"type":"url","id":"link","label":"Link"}]}],"max_blocks":3,"presets":[{"name":"Guide links","blocks":[{"type":"guide"},{"type":"guide"},{"type":"guide"}]}]}{% endschema %}
