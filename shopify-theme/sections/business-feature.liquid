<section class="business-preview container"><div><span class="eyebrow">{{ section.settings.eyebrow | escape }}</span><h2>{{ section.settings.heading | escape | newline_to_br }}</h2><p>{{ section.settings.copy | escape }}</p><a href="{{ section.settings.link | default: '/pages/untuk-bisnis' }}" class="btn">{{ section.settings.button | escape }}</a></div><div class="feature-img">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '480, 720, 1000', alt: section.settings.image.alt }}{% else %}<img src="{{ 'white-label.webp' | asset_url }}" alt="Kopi Monarchy untuk bisnis" width="1024" height="768" loading="lazy">{% endif %}</div></section>
{% schema %}{"name":"Business feature","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"MONARCHY FOR BUSINESS"},{"type":"textarea","id":"heading","label":"Heading","default":"Satu partner.\nBanyak hal jadi lebih mudah."},{"type":"textarea","id":"copy","label":"Description","default":"Dari ide coffee corner sampai kebutuhan hotel. Satu percakapan untuk memulai solusi kopi yang tepat bagi usaha Anda."},{"type":"text","id":"button","label":"Button label","default":"Untuk Bisnis"},{"type":"url","id":"link","label":"Link"},{"type":"image_picker","id":"image","label":"Image"}],"presets":[{"name":"Business feature"}]}{% endschema %}
