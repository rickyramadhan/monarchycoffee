<section class="split-feature capsule-feature"><div class="feature-img">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: section.settings.image_alt }}{% else %}<img src="{{ 'capsule-hero.webp' | asset_url }}" alt="{{ section.settings.image_alt | escape }}" loading="lazy" width="1600" height="1068">{% endif %}</div><div class="feature-copy"><span class="eyebrow">{{ section.settings.eyebrow | escape }}</span><h2>{{ section.settings.heading | escape | newline_to_br }}</h2><p>{{ section.settings.description | escape }}</p><ul class="feature-list">{% for block in section.blocks %}<li {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>{% endfor %}</ul><a href="{{ section.settings.button_link }}" class="btn">{{ section.settings.button_label | escape }}</a></div></section>
{% schema %}{"name":"Capsule feature","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"image_alt","label":"Image description","default":"Kapsul Americano Monarchy dan mesin kopi asli"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"SMALL CAPSULE. GOOD MOMENT."},{"type":"textarea","id":"heading","label":"Heading","default":"Ritual kopi Anda,\ndibuat lebih mudah."},{"type":"textarea","id":"description","label":"Description","default":"Sebelum mulai kerja. Saat jeda sebentar. Kapan pun Anda butuh kopi yang praktis, ada kapsul Monarchy."},{"type":"text","id":"button_label","label":"Button label","default":"Jelajahi Coffee Capsule"},{"type":"url","id":"button_link","label":"Button link"}],"blocks":[{"type":"point","name":"Feature point","settings":[{"type":"text","id":"text","label":"Text","default":"Untuk rumah, kantor, dan kamar hotel"}]}],"max_blocks":5,"presets":[{"name":"Capsule feature","blocks":[{"type":"point","settings":{"text":"Signature Americano & pilihan single origin"}},{"type":"point","settings":{"text":"Untuk rumah, kantor, dan kamar hotel"}},{"type":"point","settings":{"text":"Lengkapi dengan mesin yang kompatibel"}}]}]}{% endschema %}