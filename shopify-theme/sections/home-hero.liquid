<section class="hero"><div class="hero-copy"><span class="eyebrow"><i class="dash"></i> {{ section.settings.eyebrow | escape }}</span><h1>{% assign hero_lines = section.settings.heading | escape | newline_to_br | split: '<br />' %}{% for line in hero_lines %}{% if forloop.last %}<em>{{ line | strip }}</em>{% else %}{{ line | strip }}<br>{% endif %}{% endfor %}</h1><p class="subcopy">{{ section.settings.copy | escape }}</p><div class="button-row"><a href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}" class="btn">{{ section.settings.primary_label | escape }}</a><a href="{{ section.settings.secondary_link | default: '/pages/untuk-bisnis' }}" class="btn outline">{{ section.settings.secondary_label | escape }}</a></div><div class="hero-footnote"><img src="{{ 'favicon.png' | asset_url }}" alt="" width="32" height="32"><span>{{ section.settings.footnote | escape | newline_to_br }}</span></div></div><div class="hero-media">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1400 | image_tag: widths: '480, 720, 1000, 1400', sizes: '(min-width: 800px) 50vw, 100vw', fetchpriority: 'high', alt: section.settings.image.alt }}{% else %}<img src="{{ 'brand-story.webp' | asset_url }}" alt="Monarchy Coffee" width="1024" height="1536" fetchpriority="high">{% endif %}<div class="hero-stamp">{{ section.settings.stamp_top | escape }}<strong>{{ section.settings.stamp_middle | escape }}</strong>{{ section.settings.stamp_bottom | escape }}</div><div class="hero-caption"><span>{{ section.settings.caption | escape }}</span><b>01 / MONARCHY</b></div></div></section>
{% schema %}{"name":"Home hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"MONARCHY COFFEE ROASTER · EST. 2012"},{"type":"textarea","id":"heading","label":"Heading","default":"Kopi untuk\nhari Anda.\nDan usaha Anda."},{"type":"textarea","id":"copy","label":"Description","default":"Pilih kopi untuk dinikmati di rumah. Untuk bisnis, kami bantu bahas pasokan, mesin, kapsul, hingga kebutuhan hospitality—berangkat dari cara Anda menyajikan kopi."},{"type":"text","id":"primary_label","label":"Primary button","default":"Pilih Kopi untuk Rumah"},{"type":"url","id":"primary_link","label":"Primary link"},{"type":"text","id":"secondary_label","label":"Secondary button","default":"Cari Solusi Bisnis"},{"type":"url","id":"secondary_link","label":"Secondary link"},{"type":"image_picker","id":"image","label":"Hero image"},{"type":"text","id":"footnote","label":"Footnote","default":"Dipanggang untuk dinikmati.\nDisiapkan untuk dibagikan."},{"type":"text","id":"stamp_top","label":"Stamp top","default":"GOOD COFFEE"},{"type":"text","id":"stamp_middle","label":"Stamp middle","default":"since"},{"type":"text","id":"stamp_bottom","label":"Stamp bottom","default":"2012"},{"type":"text","id":"caption","label":"Image caption","default":"Dari roastery kami, untuk meja Anda."}],"presets":[{"name":"Home hero"}]}{% endschema %}
