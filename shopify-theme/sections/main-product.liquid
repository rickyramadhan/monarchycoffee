<section class="container detail product-detail">
  <div class="detail-visual product-detail__visual">
    {% if product.featured_image %}
      {{ product.featured_image | image_url: width: 1200 | image_tag: loading: 'eager', widths: '480, 720, 960, 1200', sizes: '(min-width: 800px) 50vw, 100vw', alt: product.featured_image.alt }}
    {% endif %}
  </div>
  <div class="detail-copy product-detail__copy">
    <div class="breadcrumb"><a href="{{ routes.root_url }}">{{ section.settings.home_label | escape }}</a> / <a href="{{ routes.all_products_collection_url }}">{{ section.settings.shop_label | escape }}</a> / {{ product.title | escape }}</div>
    {% if product.type != blank %}<span class="eyebrow">{{ product.type | escape }}</span>{% endif %}
    <h1>{{ product.title | escape }}</h1>
    <div class="product-detail__price"><span class="detail-price" data-product-price>{{ product.selected_or_first_available_variant.price | money }}</span>{% if product.selected_or_first_available_variant.unit_price_measurement %}<span class="small muted"> / {{ product.selected_or_first_available_variant.unit_price | money }} / {{ product.selected_or_first_available_variant.unit_price_measurement.reference_unit }}</span>{% elsif product.metafields.custom.package_size != blank %}<span class="small muted"> / {{ product.metafields.custom.package_size | escape }}</span>{% endif %}</div>
    {% if product.description != blank %}<div class="product-detail__description rte">{{ product.description }}</div>{% endif %}
    {% assign taste_notes = product.metafields.custom.taste_notes.value %}
    {% if taste_notes != blank %}<div class="taste-tags" aria-label="{{ section.settings.taste_label | escape }}">{% for note in taste_notes %}<span>{{ note | escape }}</span>{% endfor %}</div>{% endif %}
    {% form 'product', product, id: 'ProductForm', class: 'product-detail__form' %}
      {% if product.has_only_default_variant %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      {% else %}<div class="field"><label for="VariantSelect">{{ section.settings.variant_label | escape }}</label><select id="VariantSelect" name="id" data-variant-select>{% for variant in product.variants %}<option value="{{ variant.id }}" data-price="{{ variant.price }}"{% if variant == product.selected_or_first_available_variant %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{ variant.title | escape }}{% unless variant.available %} — {{ section.settings.sold_out_label | escape }}{% endunless %}</option>{% endfor %}</select></div>{% endif %}
      {% if product.metafields.custom.grind_options != blank %}<div class="field"><label for="GrindOption">{{ section.settings.grind_label | escape }}</label><select id="GrindOption" name="properties[{{ section.settings.grind_property | escape }}]">{% assign grind_options = product.metafields.custom.grind_options.value %}{% for option in grind_options %}<option>{{ option | escape }}</option>{% endfor %}</select></div>{% endif %}
      <div class="product-detail__buy-row"><div class="field product-detail__quantity"><label for="Quantity">{{ section.settings.quantity_label | escape }}</label><input id="Quantity" type="number" name="quantity" value="1" min="1" max="99" inputmode="numeric"></div><button class="btn" type="submit" name="add" data-add-to-cart{% unless product.selected_or_first_available_variant.available %} disabled{% endunless %}>{% if product.selected_or_first_available_variant.available %}{{ section.settings.add_label | escape }}{% else %}{{ section.settings.sold_out_label | escape }}{% endif %}</button></div>
    {% endform %}
    <div class="marketplace-links" aria-label="Pilihan berbelanja di marketplace">
      <p class="marketplace-links__heading">Atau beli melalui marketplace</p>
      <div class="marketplace-links__buttons">
        {% assign shopee_url = section.settings.shopee_url | strip %}
        {% assign tokopedia_url = section.settings.tokopedia_url | strip %}
        {% assign tiktok_url = section.settings.tiktok_url | strip %}
        {% if shopee_url != blank and shopee_url != '#' %}<a class="marketplace-button marketplace-button--shopee" href="{{ shopee_url | escape }}" target="_blank" rel="noopener noreferrer"><span class="marketplace-button__brand">S</span>Beli di Shopee</a>{% else %}<span class="marketplace-button marketplace-button--shopee is-unavailable" aria-disabled="true"><span class="marketplace-button__brand">S</span>Shopee <small>Segera hadir</small></span>{% endif %}
        {% if tokopedia_url != blank and tokopedia_url != '#' %}<a class="marketplace-button marketplace-button--tokopedia" href="{{ tokopedia_url | escape }}" target="_blank" rel="noopener noreferrer"><span class="marketplace-button__brand">T</span>Beli di Tokopedia</a>{% else %}<span class="marketplace-button marketplace-button--tokopedia is-unavailable" aria-disabled="true"><span class="marketplace-button__brand">T</span>Tokopedia <small>Segera hadir</small></span>{% endif %}
        {% if tiktok_url != blank and tiktok_url != '#' %}<a class="marketplace-button marketplace-button--tiktok" href="{{ tiktok_url | escape }}" target="_blank" rel="noopener noreferrer"><span class="marketplace-button__brand">♪</span>Beli di TikTok Shop</a>{% else %}<span class="marketplace-button marketplace-button--tiktok is-unavailable" aria-disabled="true"><span class="marketplace-button__brand">♪</span>TikTok Shop <small>Segera hadir</small></span>{% endif %}
      </div>
    </div>
    {% if section.settings.note != blank %}<div class="demo-note">{{ section.settings.note | escape }}</div>{% endif %}
    {% assign pairing = product.metafields.custom.pairing_note %}
    {% assign character = product.metafields.custom.character_note %}
    {% if pairing == blank %}{% case product.handle %}{% when 'spade-blend' %}{% assign pairing = 'Espresso · Kopi susu · Iced latte' %}{% assign character = 'Karakter: Pekat & kuat. Catatan rasa menggambarkan profil kopi, bukan bahan tambahan.' %}{% when 'love-blend' %}{% assign pairing = 'Espresso · Cappuccino · Latte' %}{% assign character = 'Karakter: Seimbang & lembut. Catatan rasa menggambarkan profil kopi, bukan bahan tambahan.' %}{% when 'club-blend' %}{% assign pairing = 'Americano · Long black · Kopi hitam' %}{% assign character = 'Karakter: Bersih & aromatik. Catatan rasa menggambarkan profil kopi, bukan bahan tambahan.' %}{% when 'diamond-espresso' %}{% assign pairing = 'Espresso · Flat white · Americano' %}{% assign character = 'Karakter: Manis & ekspresif. Catatan rasa menggambarkan profil kopi, bukan bahan tambahan.' %}{% when 'americano-capsule' %}{% assign pairing = 'Mesin kapsul Monarchy yang kompatibel' %}{% assign character = 'Konfirmasi kompatibilitas mesin sebelum membeli.' %}{% when 'sumatra-capsule' %}{% assign pairing = 'Mesin kapsul Monarchy yang kompatibel' %}{% assign character = 'Konfirmasi kompatibilitas mesin sebelum membeli.' %}{% when 'monarchy-capsule-machine' %}{% assign pairing = 'Kapsul Monarchy yang kompatibel' %}{% assign character = 'Konfirmasi spesifikasi sebelum membeli.' %}{% endcase %}{% endif %}
    {% if pairing != blank or character != blank %}<details class="product-detail__pairing" open><summary>{{ section.settings.pairing_heading | escape }}</summary><p>{{ pairing | metafield_text | default: pairing | escape }}{% if character != blank %} {{ character | metafield_text | default: character | escape }}{% endif %}</p></details>{% endif %}
  </div>
</section>
{% schema %}
{"name":"Main product","settings":[{"type":"text","id":"home_label","label":"Breadcrumb home label","default":"Beranda"},{"type":"text","id":"shop_label","label":"Breadcrumb shop label","default":"Belanja kopi"},{"type":"text","id":"variant_label","label":"Variant selector label","default":"Pilihan produk"},{"type":"text","id":"sold_out_label","label":"Sold out label","default":"Habis"},{"type":"text","id":"grind_label","label":"Grind selector label","default":"Pilihan gilingan"},{"type":"text","id":"grind_property","label":"Cart property name for grind","default":"Gilingan"},{"type":"text","id":"quantity_label","label":"Quantity label","default":"Jumlah"},{"type":"text","id":"add_label","label":"Add to cart button","default":"Tambah ke Keranjang"},{"type":"text","id":"taste_label","label":"Taste notes accessible label","default":"Catatan rasa"},{"type":"text","id":"pairing_heading","label":"Product pairing heading","default":"Cocok untuk apa?"},{"type":"text","id":"shopee_url","label":"Shopee store URL"},{"type":"text","id":"tokopedia_url","label":"Tokopedia store URL"},{"type":"text","id":"tiktok_url","label":"TikTok Shop URL"},{"type":"text","id":"note","label":"Product note","default":"Harga dan ketersediaan mengikuti informasi produk toko."}]}
{% endschema %}
