<article class="product-card"><a class="product-image" href="{{ card_product.url }}" aria-label="{{ settings.product_view_prefix | escape }} {{ card_product.title | escape }}">{% if card_product.featured_image %}{{ card_product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '320, 480, 700', sizes: '(min-width: 800px) 25vw, 50vw', alt: card_product.featured_image.alt }}{% endif %}</a><div class="product-info"><div class="micro">{{ card_product.type | default: settings.product_type_default | escape }}</div><h3><a href="{{ card_product.url }}">{{ card_product.title | escape }}</a></h3><p>{{ card_product.metafields.custom.short_description | default: card_product.description | strip_html | truncate: 90 | escape }}</p><div class="product-buy"><span class="price">{{ card_product.price | money }}{% if card_product.price_varies %}<small> {{ settings.price_from | escape }}</small>{% endif %}</span><a class="add-btn" href="{{ card_product.url }}" aria-label="{{ settings.product_select | escape }} {{ card_product.title | escape }}">+</a></div></div></article>
